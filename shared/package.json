{
  "name": "@template/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "hono": "4.12.32",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
