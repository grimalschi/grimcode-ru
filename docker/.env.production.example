# What a production deployment has to supply.
#
# Nothing here has a working default: a value that is wrong in production is worse than a value the
# deployment refuses to start without, so the required ones fail the Compose run instead.

# Names the Compose project and the per-service databases. Keep it stable: changing it points every
# service at a different database.
PROJECT_SLUG=

# The public origin, exactly as a visitor sees it, with the scheme and without a trailing slash.
# Links in email are built from it, and it decides whether the session cookie is marked Secure.
PUBLIC_SITE_URL=https://example.com

# The managed database. Each service uses <PROJECT_SLUG>_<service> on this server; the connection
# itself points at any database the user may connect to.
DATABASE_URL=postgres://user:password@host:5432/postgres

# --- Email -------------------------------------------------------------------
# `log` records messages without sending them. Set `unisender` and the credentials below to send.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=

UNISENDER_GO_API_KEY=
UNISENDER_GO_API_URL=

# --- Optional ----------------------------------------------------------------
# How long a session lasts. Thirty days by default.
AUTH_SESSION_TTL_SECONDS=2592000
