# Every supported variable of the template, without real secrets.
#
# Local start: copy this file to `.env` and run the project. The values below work as they are —
# nothing generates them and nothing rewrites them. `.env.example` is stored in Git, `.env` is not.
#
# In production the person responsible for deployment sets PUBLIC_SITE_URL, DATABASE_URL and the
# secrets. PostgreSQL is not part of the project there: it is a managed resource reached through
# DATABASE_URL, and the local ports below are not used at all.

# --- Project -----------------------------------------------------------------
# Technical project name. Used for the Compose project, cookie names and database names, so change
# it before the first run: databases are named <PROJECT_SLUG>_<service>.
# Lower case letters, digits and underscores, starting with a letter.
PROJECT_SLUG=template

# External origin of the project. Locally this is the gateway port below; in production it is the
# real address, and its scheme decides whether the session cookie is marked Secure.
PUBLIC_SITE_URL=http://127.0.0.1:63000

# --- Local host ports ---------------------------------------------------------
# Only used locally, and only from the range below.
#
# The range's first port belongs to the main checkout and to nothing else, so `PUBLIC_SITE_URL`
# above always names it and a worktree never takes it away. Worktrees pick free ports from the rest
# of the range, which is why the range exists: they are created and thrown away often, and nothing
# else on the machine is expected to listen here.
PORT_RANGE_START=63000
PORT_RANGE_END=63099

# The main checkout: the first port of the range for the application, the next one for PostgreSQL.
# Change them only together with PORT_RANGE_START and PUBLIC_SITE_URL.
GATEWAY_PORT=63000
POSTGRES_PORT=63001

# Both bind to loopback by default. Set GATEWAY_BIND_HOST=0.0.0.0 to reach the application from
# another machine — a virtual machine's port forwarding, or a phone on the same network. The
# database has its own variable so that opening the application never opens PostgreSQL too.
GATEWAY_BIND_HOST=127.0.0.1
POSTGRES_BIND_HOST=127.0.0.1

# --- Database -----------------------------------------------------------------
# Base connection. Each stateful service owns a separate database on this server and applies its own
# versioned migrations. Database names are <PROJECT_SLUG>_<service>.
#
# Locally this points at the PostgreSQL container of the project, whose credentials are the two
# below. In production it points at the managed database and these two are unused.
DATABASE_URL=postgres://template:template@postgres:5432/postgres

# Credentials of the local PostgreSQL container. Deliberately not a secret: this database exists
# only on the developer's machine and never leaves loopback.
POSTGRES_USER=template
POSTGRES_PASSWORD=template

# Optional per-service overrides for deployments that need different hosts or credentials.
# Each is declared for its own service only: a container that could read another service's
# connection would be holding credentials to a database it may never open.
# DATABASE_URL_ADMIN=
# DATABASE_URL_AUTH=
# DATABASE_URL_USERS=
# DATABASE_URL_NOTIFICATIONS=
# DATABASE_URL_EMAIL=

# --- Sessions -----------------------------------------------------------------
# Session lifetime in seconds.
AUTH_SESSION_TTL_SECONDS=2592000
# Failed sign-in attempts allowed per address inside one window, and the window itself.
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Email --------------------------------------------------------------------
# log      — write messages to the delivery log and never send them outside (local default)
# unisender — UniSender Go, the only ready production transport of the template
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# UniSender Go credentials. Empty locally, where nothing is sent outside anyway.
UNISENDER_GO_API_KEY=
# Only for a different endpoint; the transport already knows the official one.
# UNISENDER_GO_API_URL=

# --- Adminer ------------------------------------------------------------------
# Optional connection-level overrides for the internal Adminer container.
# When empty, Adminer reuses DATABASE_URL.
# ADMINER_SERVER=
# ADMINER_USERNAME=
# ADMINER_PASSWORD=

# --- Tests --------------------------------------------------------------------
# The suites find the stack by GATEWAY_PORT above; ACCEPTANCE_BASE_URL exists only to point them at
# some other one, and belongs on the command line rather than here.
#
# The account the suites work as. Left empty on purpose: on a stack with no accounts yet they
# register one and it becomes the owner, which is the rule under test. Fill these in only for a
# stack that already has accounts, otherwise the suites cannot reach the panel.
# ACCEPTANCE_OWNER_EMAIL=
# ACCEPTANCE_OWNER_PASSWORD=
