# Техническое имя проекта: строчная латинская буква, затем буквы, цифры и подчёркивания; до 63 символов.
# Используется в cookie и как имя новой базы при bootstrap worktree.
PROJECT_SLUG=template

# Диапазон портов для локального запуска
PORT_RANGE_START=63000
PORT_RANGE_END=63020

# Локально - первый localhost порт из диапазона портов для локального запуска
# В продакшне - внешний адрес проекта без порта
PUBLIC_SITE_URL=http://127.0.0.1:63000

# Порт, на котором слушает приложение. Основной копии — первый порт диапазона, каждому worktree
# свой; выбирает bootstrap. В продакшне PORT задаёт платформа.
PORT=63000

# Одна база на установку или worktree; внутри каждый модуль создаёт собственную схему.
# Строка указывает на уже созданную базу и без изменений передаётся всем модулям.
# Локальная подготовка (CREATEDB нужен bootstrap, приложение только создаёт схемы):
#   sudo -u postgres createuser --createdb --pwprompt template
#   sudo -u postgres createdb --owner=template template
DATABASE_URL=postgres://template:template@127.0.0.1:5432/template

# Срок сессии: положительное целое число секунд. По умолчанию Auth задаёт 30 дней.
AUTH_SESSION_TTL_SECONDS=2592000

# Как отправляем письма: log (письма сохраняются локально) / unisender (Unisender Go)
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# Ключ Unisender Go, если используется
UNISENDER_GO_API_KEY=
