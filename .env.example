# Every supported variable of the template, without real secrets.
# `.env.example` is stored in Git. `.env` is ignored and created by `pnpm bootstrap`.
#
# Locally bootstrap picks PROJECT_SLUG, free host ports and PUBLIC_SITE_URL by itself.
# In production the person responsible for deployment sets PUBLIC_SITE_URL, DATABASE_URL
# and the secrets; GATEWAY_PORT and POSTGRES_PORT are not used there.

# --- Project -----------------------------------------------------------------
# Technical project name. Used for the Compose project, cookie names and database names.
PROJECT_SLUG=template

# Node environment of the running containers: development | production
NODE_ENV=development

# External origin of the project. Locally written by bootstrap, in production set by a human.
PUBLIC_SITE_URL=http://127.0.0.1:8080

# --- Local host ports ---------------------------------------------------------
# Only used locally. Bootstrap picks free values; a manual value is an override.
#
# Both bind to loopback by default. Set GATEWAY_BIND_HOST=0.0.0.0 to reach the application from
# another machine — a virtual machine's port forwarding, or a phone on the same network. The
# database has its own variable so that opening the application never opens PostgreSQL too.
GATEWAY_PORT=8080
POSTGRES_PORT=5432
GATEWAY_BIND_HOST=127.0.0.1
POSTGRES_BIND_HOST=127.0.0.1

# --- Database -----------------------------------------------------------------
# Base connection. Each stateful service owns a separate database on this server and
# applies its own versioned migrations. Database names are <PROJECT_SLUG>_<service>.
DATABASE_URL=postgres://template:template@postgres:5432/postgres

# Credentials of the local PostgreSQL container. Not used in production, where PostgreSQL
# is an external managed resource of the deployment platform.
POSTGRES_USER=template
POSTGRES_PASSWORD=template

# Optional per-service overrides for deployments that need different hosts or credentials.
# DATABASE_URL_ADMIN=
# DATABASE_URL_AUTH=
# DATABASE_URL_USERS=
# DATABASE_URL_NOTIFICATIONS=
# DATABASE_URL_EMAIL=

# --- Sessions -----------------------------------------------------------------
# Secret used by Auth to sign session cookies. Bootstrap generates a local value.
# Session lifetime in seconds.
AUTH_SESSION_TTL_SECONDS=2592000

# --- Email --------------------------------------------------------------------
# log      — write messages to the delivery log and never send them outside (local default)
# unisender — UniSender Go, the only ready production transport of the template
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# UniSender Go credentials. Empty locally.
UNISENDER_GO_API_KEY=
UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1

# --- Adminer ------------------------------------------------------------------
# Optional connection-level overrides for the internal Adminer container.
# When empty, Adminer reuses DATABASE_URL.
# TEMPLATE_ADMINER_SERVER=
# TEMPLATE_ADMINER_USERNAME=
# TEMPLATE_ADMINER_PASSWORD=
