# Техническое имя проекта: строчные латинские буквы, цифры и подчёркивания.
PROJECT_SLUG=template

# Локально - первый localhost порт из диапазона ниже.
# В продакшне - внешний адрес проекта без порта.
PUBLIC_SITE_URL=http://127.0.0.1:63000

# Диапазон портов для локального запуска.
PORT_RANGE_START=63000
PORT_RANGE_END=63020

# Основная копия: первый порт диапазона приложению, следующий — PostgreSQL.
# Менять только вместе с PORT_RANGE_START и PUBLIC_SITE_URL.
GATEWAY_PORT=63000
POSTGRES_PORT=63001

# Слушает все интерфейсы, чтобы проект открывался и с другой машины: проброс из виртуалки,
# телефон в той же сети. Поставьте 127.0.0.1, если запускаетесь в чужой сети — до регистрации
# первого аккаунта права владельца достанутся тому, кто зарегистрируется раньше.
# База наружу не выходит в любом случае, в продакшне порт не публикуется вовсе.
GATEWAY_BIND_HOST=0.0.0.0

# --- База данных --------------------------------------------------------------
# Общее подключение. У каждого сервиса с состоянием своя база на этом сервере,
# и миграции он применяет сам при старте.
DATABASE_URL=postgres://template:template@postgres:5432/postgres

# --- Сессии и вход ------------------------------------------------------------
# Сколько живёт сессия, в секундах.
AUTH_SESSION_TTL_SECONDS=2592000

# Сколько неудачных попыток входа разрешено на один адрес и за какое окно, в секундах.
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Почта --------------------------------------------------------------------
# log       — письма остаются в журнале отправки и наружу не уходят (локально)
# unisender — UniSender Go, готовый продакшн-транспорт шаблона
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# Ключ UniSender Go. Локально пуст: отправлять всё равно некуда.
UNISENDER_GO_API_KEY=
# Только если нужен другой адрес API — официальный транспорт знает сам.
# UNISENDER_GO_API_URL=

# --- Тесты --------------------------------------------------------------------
# Владелец, под которым работают тесты. Нужен, когда в проекте уже есть аккаунты:
# на пустом они регистрируют владельца сами.
# ACCEPTANCE_OWNER_EMAIL=
# ACCEPTANCE_OWNER_PASSWORD=
