# Все переменные проекта. Настоящих секретов здесь нет.
#
# Локальный запуск: скопируйте этот файл в .env и запускайте — значения ниже рабочие.
# .env.example лежит в Git, .env — нет.
#
# В продакшне PUBLIC_SITE_URL, DATABASE_URL и секреты задаёт тот, кто настраивает деплой.
# Порты и пароль PostgreSQL там не нужны: база поднимается отдельно.

# --- Проект -------------------------------------------------------------------
# Техническое имя проекта: имя compose-проекта, префикс cookie, имена баз (<slug>_auth).
# Строчные латинские буквы, цифры и подчёркивания, первый символ — буква.
PROJECT_SLUG=template

# Внешний адрес проекта. Локально — порт gateway, в продакшне настоящий адрес.
# По схеме (http или https) решается, ставить ли сессионной cookie флаг Secure.
PUBLIC_SITE_URL=http://127.0.0.1:63000

# --- Порты --------------------------------------------------------------------
# Диапазон, в котором проект запускается локально. Первый порт — всегда основной копии,
# ветки в worktree берут свободные из остальных.
PORT_RANGE_START=63000
PORT_RANGE_END=63099

# Основная копия: первый порт диапазона приложению, следующий — PostgreSQL.
# Менять только вместе с PORT_RANGE_START и PUBLIC_SITE_URL.
GATEWAY_PORT=63000
POSTGRES_PORT=63001

# Слушают только localhost. GATEWAY_BIND_HOST=0.0.0.0 открывает проект другим машинам:
# проброс из виртуалки, телефон в той же сети. У базы переменная своя, чтобы вместе
# с приложением наружу не уехала она.
GATEWAY_BIND_HOST=127.0.0.1
POSTGRES_BIND_HOST=127.0.0.1

# --- База данных --------------------------------------------------------------
# Общее подключение. У каждого сервиса с состоянием своя база на этом сервере,
# и миграции он применяет сам при старте.
DATABASE_URL=postgres://template:template@postgres:5432/postgres

# Логин и пароль локального контейнера PostgreSQL. Не секрет: эта база живёт только
# на машине разработчика и наружу не смотрит.
POSTGRES_USER=template
POSTGRES_PASSWORD=template

# Отдельное подключение для одного сервиса, если его база на другом сервере или под
# другими правами. Каждое объявлено только своему сервису: чужие доступы ему не видны.
# DATABASE_URL_ADMIN=
# DATABASE_URL_AUTH=
# DATABASE_URL_USERS=
# DATABASE_URL_NOTIFICATIONS=
# DATABASE_URL_EMAIL=

# --- Сессии и вход ------------------------------------------------------------
# Сколько живёт сессия, в секундах.
AUTH_SESSION_TTL_SECONDS=2592000

# Сколько неудачных попыток входа разрешено на один адрес и за какое окно, в секундах.
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- Почта --------------------------------------------------------------------
# log       — письма остаются в журнале отправки и наружу не уходят (локально)
# unisender — UniSender Go, готовый продакшн-транспорт шаблона
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# Ключ UniSender Go. Локально пуст: отправлять всё равно некуда.
UNISENDER_GO_API_KEY=
# Только если нужен другой адрес API — официальный транспорт знает сам.
# UNISENDER_GO_API_URL=

# --- Adminer ------------------------------------------------------------------
# Отдельные доступы для консоли базы, если ей нужны права поменьше, чем у сервисов.
# Пусто — берёт их из DATABASE_URL.
# ADMINER_SERVER=
# ADMINER_USERNAME=
# ADMINER_PASSWORD=

# --- Тесты --------------------------------------------------------------------
# Адрес проекта тесты берут из GATEWAY_PORT. ACCEPTANCE_BASE_URL нужен, только чтобы
# нацелить прогон на другой стенд, и место ему в командной строке, а не здесь.
#
# Владелец, под которым работают тесты. Пусто намеренно: на пустом стенде они регистрируют
# аккаунт сами, и он становится владельцем — это и проверяется. Заполнять, только если
# аккаунты уже есть.
# ACCEPTANCE_OWNER_EMAIL=
# ACCEPTANCE_OWNER_PASSWORD=
