{
  "name": "grimcode-ru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap:worktree": "node scripts/bootstrap-worktree.mjs",
    "build": "turbo run build && tsc -b tsconfig.entry.json",
    "typecheck": "turbo run typecheck && tsc -b tsconfig.entry.json",
    "test": "turbo run test && vitest run",
    "lint": "turbo run lint && eslint index.ts index.test.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:procedures": "node scripts/check-procedures.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:service-ids": "node scripts/check-service-ids.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:dependencies && pnpm run check:boundaries && pnpm run check:procedures && pnpm run check:migrations && pnpm run check:service-ids && pnpm run check:scripts",
    "dev": "pnpm run build && node --env-file=.env dist/index.js",
    "test:acceptance": "pnpm --filter @template/tests acceptance",
    "test:browser": "pnpm --filter @template/tests browser"
  },
  "dependencies": {
    "@grimcode/pg-interface": "workspace:*",
    "@hono/node-server": "2.0.11",
    "@template/admin": "workspace:*",
    "@template/app": "workspace:*",
    "@template/auth": "workspace:*",
    "@template/email": "workspace:*",
    "@template/gateway": "workspace:*",
    "@template/notifications": "workspace:*",
    "@template/shared": "workspace:*",
    "@template/site": "workspace:*",
    "@template/users": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
