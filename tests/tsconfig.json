{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The Playwright specs pass callbacks that run inside the page, so DOM types belong here even
    // though the suite itself runs on Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "browser/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
