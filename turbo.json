{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Anything a package builds outside `dist` belongs here: without `web/dist` a cache hit skipped
      // `vite build`, leaving yesterday's screen on disk while every check stayed green.
      "outputs": ["dist/**", "web/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@template/web#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      // `build`, not `^build`: tests read what their own package built, so a clean checkout fails
      // when only the dependencies are built.
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
